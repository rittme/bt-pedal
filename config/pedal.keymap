#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define BT_CTRL 1

/*
 * Key positions: 0 = center pedal, 1 = left pedal, 2 = right pedal.
 *
 * - Hold center + right, then tap left: clear the selected BLE profile.
 * - Hold all three pedals for 5 seconds: enter the UF2 bootloader.
 */

/ {
    behaviors {
        /* Hold all pedals for 5 s -> bootloader; releasing earlier does nothing. */
        bootloader_hold: bootloader_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <5000>;
            bindings = <&bootloader>, <&none>;
        };

        /* BT_CLR expands to two cells, so wrap it for use inside a hold-tap. */
        bt_clear: bt_clear {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };

        /*
         * Left pedal while the BT layer is active: tap -> clear profile,
         * hold 5 s -> bootloader. The hold path covers the case where all
         * three pedals were pressed too slowly to trigger the 3-key combo.
         */
        bt_clear_or_bootloader: bt_clear_or_bootloader {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <5000>;
            bindings = <&bootloader>, <&bt_clear>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
                &kp F16  &kp F17  &kp F18
            >;
        };

        bt_ctrl_layer {
            bindings = <
                &trans   &bt_clear_or_bootloader 0 0   &trans
            >;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_bt_ctrl {
            timeout-ms = <200>;
            slow-release;
            layers = <BASE>;
            key-positions = <0 2>;
            bindings = <&mo BT_CTRL>;
        };

        combo_bootloader {
            timeout-ms = <200>;
            slow-release;
            layers = <BASE>;
            key-positions = <0 1 2>;
            bindings = <&bootloader_hold 0 0>;
        };
    };
};
